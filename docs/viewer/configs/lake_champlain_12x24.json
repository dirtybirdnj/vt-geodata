{
  "id": "lake_champlain_12x24",
  "version": "1.0",
  "title": "Lake Champlain 12x24 Print Map",
  "description": "12x24 inch print-ready Lake Champlain map showing full lake with VT/NY context",

  "map": {
    "center": [44.3, -73.3],
    "zoom": 9,
    "tiles": null,
    "bounds": {
      "note": "12x24 aspect ratio (1:2) - Lake Champlain centered",
      "north": 45.2,
      "south": 43.2,
      "west": -73.85,
      "east": -72.85
    }
  },

  "ui": {
    "colorScheme": "#0d47a1",
    "infoBox": {
      "width": "420px",
      "content": {
        "subtitle": "<strong>Lake Champlain 12x24\" Print Map</strong><br>Full lake with VT towns and NY counties",
        "stats": [
          { "label": "Lake Area", "value": "1,315 sq km" },
          { "label": "Islands", "value": "31 preserved" },
          { "label": "Length", "value": "~193 km (120 mi)" }
        ],
        "footer": "<em>Designed for 12x24\" print at 1:2 aspect ratio</em>"
      }
    }
  },

  "layers": [
    {
      "id": "ny_champlain_counties",
      "name": "NY Champlain Counties",
      "source": "../json/ny_champlain_counties.json",
      "zIndex": 1,
      "style": {
        "type": "static",
        "fillColor": "#eceff1",
        "color": "#90a4ae",
        "weight": 1,
        "fillOpacity": 0.5
      },
      "tooltip": {
        "fields": ["NAME"],
        "aliases": ["NY County:"]
      }
    },
    {
      "id": "vt_lakefront_towns",
      "name": "VT Lakefront Towns",
      "source": "../json/vt_towns_with_water_cutouts.json",
      "zIndex": 2,
      "filter": {
        "note": "Filter to towns touching Lake Champlain - see metadata for list",
        "counties": ["Addison", "Chittenden", "Franklin", "Grand Isle"]
      },
      "style": {
        "type": "colorMap",
        "property": "county_name",
        "colorMap": {
          "Addison": "#66bb6a",
          "Chittenden": "#ef5350",
          "Franklin": "#26c6da",
          "Grand Isle": "#7e57c2"
        },
        "color": "#424242",
        "weight": 0.5,
        "fillOpacity": 0.5
      },
      "tooltip": {
        "fields": ["NAME", "county_name", "water_cutout_applied"],
        "aliases": ["Town:", "County:", "Water Cutout:"]
      }
    },
    {
      "id": "lake_champlain",
      "name": "Lake Champlain",
      "source": "../json/lake_champlain_combined.json",
      "zIndex": 3,
      "style": {
        "type": "static",
        "fillColor": "#1565c0",
        "color": "#0d47a1",
        "weight": 2,
        "fillOpacity": 0.8
      },
      "tooltip": {
        "fields": ["NAME", "area_sqkm", "vt_features", "ny_features"],
        "aliases": ["Name:", "Total Area (sq km):", "VT Features:", "NY Features:"]
      }
    }
  ],

  "features": {
    "clickToSelect": {
      "enabled": true,
      "multiSelect": true,
      "highlightColor": "#ff1493",
      "highlightOpacity": 0.8
    },
    "jsonDisplay": {
      "enabled": false
    },
    "layerControl": {
      "enabled": true
    }
  },

  "print": {
    "size": "12x24",
    "units": "inches",
    "aspectRatio": "1:2",
    "dpi": 300,
    "orientation": "portrait"
  },

  "metadata": {
    "dataSources": [
      "Lake Champlain: Census TIGER 2022 (VT + NY combined)",
      "VT Towns: US Census TIGER/Line County Subdivisions 2023",
      "NY Counties: Census TIGER 2023"
    ],
    "tags": ["champlain", "lake", "print", "12x24", "islands", "water"],
    "rebuildable": true,
    "upstreamFiles": [
      "docs/json/lake_champlain_combined.json",
      "docs/json/vt_towns_with_water_cutouts.json",
      "docs/json/ny_champlain_counties.json"
    ],
    "lakefrontCounties": {
      "VT": ["Addison", "Chittenden", "Franklin", "Grand Isle"],
      "NY": ["Clinton", "Essex", "Washington"]
    }
  }
}
