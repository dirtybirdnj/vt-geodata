      "style": {
        "type": "static",
        "fillColor": "#e8e8e8",
        "color": "#9e9e9e",
        "weight": 0.75,
        "fillOpacity": 0.6
      },
      "tooltip": {
        "fields": ["NAME"],
        "aliases": ["NY County:"]
      }
    },
    {
      "id": "nh_counties",
      "name": "New Hampshire Counties",
      "source": "../json/nh_counties_grey.json",
      "zIndex": 2,
      "style": {
        "type": "static",
        "fillColor": "#e0e0e0",
        "color": "#9e9e9e",
        "weight": 0.75,
        "fillOpacity": 0.6
      },
      "tooltip": {
        "fields": ["NAME"],
        "aliases": ["NH County:"]
      }
    },
    {
      "id": "ma_counties",
