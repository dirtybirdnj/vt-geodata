{
  "id": "lake_champlain_12x24",
  "version": "1.1",
  "title": "Lake Champlain 12x24 Print Map",
  "description": "12x24 inch print-ready Lake Champlain map showing full lake with VT/NY/Quebec context",

  "map": {
    "center": [44.5, -73.2],
    "zoom": 9,
    "tiles": null
  },

  "ui": {
    "colorScheme": "#0d47a1",
    "infoBox": {
      "width": "420px",
      "content": {
        "subtitle": "<strong>Lake Champlain 12x24\" Print Map</strong><br>Full lake with VT towns and surrounding regions",
        "stats": [
          { "label": "Lake Area", "value": "~1,537 sq km" },
          { "label": "Islands", "value": "53 preserved" },
          { "label": "Length", "value": "~193 km (120 mi)" }
        ],
        "footer": "Designed for 12x24 inch print at 1:2 aspect ratio"
      }
    }
  },

  "layers": [
    {
      "id": "quebec_mrc",
      "name": "Quebec (MRCs)",
      "source": "../json/quebec_border_mrc.json",
      "zIndex": 1,
      "style": {
        "type": "static",
        "fillColor": "#f5f5f5",
        "color": "#bdbdbd",
        "weight": 0.5,
        "fillOpacity": 0.5
      },
      "tooltip": {
        "fields": ["MUS_NM_MRC"],
        "aliases": ["Quebec MRC:"]
      }
    },
    {
      "id": "ny_counties",
      "name": "New York Counties",
