{
  "id": "ny_towns",
  "version": "1.0",
  "title": "New York Towns",
  "description": "NY towns adjacent to Vermont - debug view",

  "map": {
    "center": [43.8, -73.4],
    "zoom": 9,
    "tiles": null
  },

  "ui": {
    "colorScheme": "#1a237e",
    "infoBox": {
      "width": "400px",
      "content": {
        "subtitle": "NY towns from Census TIGER cousub data",
        "footer": "Census TIGER 2023"
      }
    }
  },

  "layers": [
    {
      "id": "ny_towns",
      "name": "NY Towns (with water cutouts)",
      "source": "../json/ny_towns_with_water_cutouts.json",
      "zIndex": 1,
      "style": {
        "type": "static",
        "fillColor": "#e3e8ed",
        "color": "#8a9bab",
        "weight": 0.5,
        "fillOpacity": 0.6
      },
      "tooltip": {
        "fields": ["NAME", "county_name"],
        "aliases": ["Town:", "County:"]
      }
    },
    {
      "id": "ny_towns_original",
      "name": "NY Towns (original)",
      "source": "../json/ny_towns.json",
      "zIndex": 2,
      "style": {
        "type": "static",
        "fillColor": "#c5cae9",
        "color": "#3f51b5",
        "weight": 0.5,
        "fillOpacity": 0.4
      },
      "tooltip": {
        "fields": ["NAME", "county_name"],
        "aliases": ["Town:", "County:"]
      }
    }
  ],

  "features": {
    "clickToSelect": {
      "enabled": true,
      "multiSelect": true
    },
    "jsonDisplay": {
      "enabled": false
    },
    "layerControl": {
      "enabled": true,
      "position": "topright",
      "collapsed": false
    }
  },

  "metadata": {
    "dataSources": [
      "US Census TIGER 2023 cousub"
    ],
    "tags": ["towns", "newyork", "debug"]
  }
}
