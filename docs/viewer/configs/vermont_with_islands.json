{
  "id": "vermont_with_islands",
  "version": "2.0",
  "title": "Vermont & Lake Champlain Region",
  "description": "Vermont with surrounding counties (NY, NH, MA) and combined Lake Champlain",

  "map": {
    "center": [44.0, -72.8],
    "zoom": 8,
    "tiles": null
  },

  "ui": {
    "colorScheme": "#2c5f2d",
    "infoBox": {
      "width": "420px",
      "content": {
        "subtitle": "<strong>Vermont & Regional Context</strong><br>VT with NY, NH, MA counties and Lake Champlain",
        "stats": [
          { "label": "VT Towns", "value": "256" },
          { "label": "Lake Champlain", "value": "1,315 sq km" },
          { "label": "Surrounding Counties", "value": "12" }
        ],
        "footer": "<em>Islands preserved as gaps in the lake</em>"
      }
    }
  },

  "layers": [
    {
      "id": "surrounding_counties",
      "name": "Surrounding Counties",
      "source": "../json/surrounding_counties.json",
      "zIndex": 1,
      "style": {
        "type": "static",
        "fillColor": "#e0e0e0",
        "color": "#9e9e9e",
        "weight": 1,
        "fillOpacity": 0.3
      },
      "tooltip": {
        "fields": ["NAME", "STATE"],
        "aliases": ["County:", "State:"]
      }
    },
    {
      "id": "vt_boundary",
      "name": "Vermont",
      "source": "../json/vermont_boundary_detailed.json",
      "zIndex": 2,
      "style": {
        "type": "static",
        "fillColor": "#2c5f2d",
        "color": "#1e4320",
        "weight": 3,
        "fillOpacity": 0.3
      }
    },
    {
      "id": "lake_champlain",
      "name": "Lake Champlain",
      "source": "../json/lake_champlain_combined.json",
      "zIndex": 3,
      "style": {
        "type": "static",
        "fillColor": "#0d47a1",
        "color": "#01579b",
        "weight": 2,
        "fillOpacity": 0.6
      },
      "tooltip": {
        "fields": ["NAME", "area_sqkm"],
        "aliases": ["Name:", "Area (sq km):"]
      }
    }
  ],

  "features": {
    "clickToSelect": {
      "enabled": false
    },
    "jsonDisplay": {
      "enabled": false
    },
    "layerControl": {
      "enabled": true
    }
  },

  "metadata": {
    "dataSources": [
      "Vermont Open Geodata Portal",
      "US Census TIGER/Line 2022-2023"
    ],
    "tags": ["vermont", "newyork", "newhampshire", "massachusetts", "champlain", "islands", "region", "vector"],
    "aspectRatio": "2:3",
    "surroundingCounties": {
      "NY": ["Clinton", "Essex", "Washington", "Franklin", "Warren", "Saratoga", "Rensselaer"],
      "NH": ["Coos", "Grafton", "Sullivan", "Cheshire"],
      "MA": ["Berkshire"]
    }
  }
}
