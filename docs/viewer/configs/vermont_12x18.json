{
  "id": "vermont_12x18",
  "version": "1.0",
  "title": "Vermont 12x18 Print Map",
  "description": "12x18 inch print-ready Vermont map with towns, Lake Champlain, and regional context",

  "map": {
    "center": [44.0, -72.7],
    "zoom": 8,
    "tiles": null
  },

  "ui": {
    "colorScheme": "#2c5f2d",
    "infoBox": {
      "width": "450px",
      "content": {
        "subtitle": "<strong>Vermont 12x18\" Print Map</strong><br>256 towns colored by county, surrounding states for context",
        "stats": [
          { "label": "Vermont Towns", "value": "256" },
          { "label": "Lake Champlain", "value": "1,315 sq km (combined)" },
          { "label": "Surrounding Counties", "value": "12 (NY, NH, MA)" }
        ],
        "footer": "Designed for 12x18 inch print at 2:3 aspect ratio"
      }
    }
  },

  "layers": [
    {
      "id": "surrounding_counties",
      "name": "Surrounding Counties (NY, NH, MA)",
      "source": "../json/surrounding_counties.json",
      "zIndex": 1,
      "style": {
        "type": "static",
        "fillColor": "#f5f5f5",
        "color": "#bdbdbd",
        "weight": 1,
        "fillOpacity": 0.4
      },
      "tooltip": {
        "fields": ["NAME", "STATE"],
        "aliases": ["County:", "State:"]
      }
    },
    {
      "id": "vt_towns",
      "name": "Vermont Towns",
      "source": "../json/vt_towns_with_water_cutouts.json",
      "zIndex": 2,
      "style": {
        "type": "colorMap",
        "property": "county_name",
        "colorMap": {
          "Addison": "#66bb6a",
          "Bennington": "#42a5f5",
          "Caledonia": "#ab47bc",
          "Chittenden": "#ef5350",
          "Essex": "#ffa726",
          "Franklin": "#26c6da",
          "Grand Isle": "#7e57c2",
          "Lamoille": "#ec407a",
          "Orange": "#5c6bc0",
          "Orleans": "#9ccc65",
          "Rutland": "#29b6f6",
          "Washington": "#ff7043",
          "Windham": "#26a69a",
          "Windsor": "#ffd54f"
        },
        "color": "#424242",
        "weight": 0.5,
        "fillOpacity": 0.6
      },
      "tooltip": {
        "fields": ["NAME", "county_name"],
        "aliases": ["Town:", "County:"]
      }
    },
    {
      "id": "lake_champlain",
      "name": "Lake Champlain (Combined)",
      "source": "../json/lake_champlain_combined.json",
      "zIndex": 3,
      "style": {
        "type": "static",
        "fillColor": "#1565c0",
        "color": "#0d47a1",
        "weight": 1.5,
        "fillOpacity": 0.7
      },
      "tooltip": {
        "fields": ["NAME", "area_sqkm"],
        "aliases": ["Name:", "Area (sq km):"]
      }
    },
    {
      "id": "vt_boundary",
      "name": "Vermont Border",
      "source": "../json/vermont_boundary_detailed.json",
      "zIndex": 4,
      "style": {
        "type": "static",
        "fillColor": "transparent",
        "color": "#1e4320",
        "weight": 3,
        "fillOpacity": 0
      }
    }
  ],

  "features": {
    "clickToSelect": {
      "enabled": true,
      "multiSelect": true,
      "highlightColor": "#ff1493",
      "highlightOpacity": 0.8,
      "outputFields": ["GEOID", "NAME", "county_name"]
    },
    "jsonDisplay": {
      "enabled": true,
      "position": "bottom-right",
      "width": "350px",
      "maxHeight": "300px",
      "title": "Selected Towns",
      "format": "object"
    },
    "layerControl": {
      "enabled": true,
      "position": "topright",
      "collapsed": false
    }
  },

  "print": {
    "size": "12x18",
    "units": "inches",
    "aspectRatio": "2:3",
    "dpi": 300,
    "orientation": "portrait"
  },

  "metadata": {
    "dataSources": [
      "VT Towns: US Census TIGER/Line County Subdivisions 2023",
      "Lake Champlain: Census TIGER 2022 (VT + NY combined)",
      "Surrounding Counties: Census TIGER 2023"
    ],
    "tags": ["vermont", "towns", "print", "12x18", "champlain", "regional"],
    "rebuildable": true,
    "upstreamFiles": [
      "docs/json/vt_towns_with_water_cutouts.json",
      "docs/json/lake_champlain_combined.json",
      "docs/json/surrounding_counties.json",
      "docs/json/vermont_boundary_detailed.json"
    ]
  }
}
