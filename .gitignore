# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# Data files (large datasets) - downloaded during build, not committed
data/
!data/.gitkeep

# Downloaded Census TIGER data (regenerated during build)
*.zip
!.gitkeep

# Output files (local only)
output/
!output/.gitkeep

# GitHub Pages - DO commit these
!docs/*.html
!docs/*.css
!docs/*.js

# Exclude large comprehensive maps (>50 MB) - generate locally when needed
docs/ny_census_water_all.html
docs/ny_census_water_all_vector.html
docs/vt_opendata_water.html
docs/vt_opendata_water_vector.html

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Session notes (local workflow)
LAST_SESSION.md
NEXT_SESSION.md

# Screenshots (local debugging)
screenshots/

# Keep directory structure
!.gitkeep
